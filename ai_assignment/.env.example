GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Optional Groq fallback
GROQ_API_KEY=your_groq_api_key_here

# Django Settings
SECRET_KEY=django-insecure-ai-assignment-secret-key-2026-production-ready
DEBUG=True
ALLOWED_HOSTS=*
